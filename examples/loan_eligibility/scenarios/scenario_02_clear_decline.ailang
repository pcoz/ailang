#ailang v0.8.2
# ============================================================
# Generated scenario: scenario_02_clear_decline
# Applicant: Marcus Reilly, credit=590, income=$38,000/yr, requesting $12,000 over 60mo
# Generated by scenarios/generate_scenarios.py -- do not edit
# ============================================================
# ============================================================
# Personal Loan Eligibility -- AILang Business-Rules Engine
# ============================================================
#
# This program decides whether to approve a personal loan application.
# It demonstrates how a regulated business-rules workflow can be expressed
# as typed AILang reasoning operations interleaved with deterministic
# Python computation.
#
# Pipeline:
#   1. Deterministic affordability math       -> EXECUTE_CODE
#   2. Hard rule eligibility check            -> DEDUCE   (Sonnet-class)
#   3. Soft factor / borderline judgment      -> WEIGH    (Opus-class)
#   4. Final decision synthesis               -> SYNTHESIZE (Opus-class)
#   5. Audit log + decision letter formatting -> EXECUTE_CODE
#
# The program is the spec.  The same text a compliance officer reads
# to understand the policy is what AIEX executes -- there is no separate
# "rules document -> translated into Java" step where intent gets lost.
#
# To run a scenario, copy this file into scenarios/<name>.ailang and
# replace the SET applicant block with the scenario's applicant data.

# ============================================================
# Inputs -- applicant + product
# ============================================================
# The applicant block is the only thing that varies between scenarios.
# Every other element of the program is fixed business policy.

SET applicant TO {
    name: "Marcus Reilly",
    age: 29,
    credit_score: 590,
    annual_income_usd: 38000,
    monthly_debt_obligations_usd: 1100,
    employment_status: "part_time",
    employment_tenure_months: 5,
    industry: "retail",
    residence_status: "rents",
    requested_loan_amount_usd: 12000,
    requested_term_months: 60,
    bankruptcies_last_7_years: 1,
    fraud_flags: [],
    months_with_lender: 4,
    recent_credit_inquiries_6mo: 8
}

# The product carries the policy thresholds.  In a real deployment this
# would be retrieved from a product-catalogue service; here we inline it
# so the example is self-contained.
SET product TO {
    name: "Personal Loan -- Standard",
    base_apr_pct: 11.9,
    min_credit_score: 660,
    max_dti_pct: 43.0,
    max_loan_amount_usd: 50000,
    max_term_months: 84,
    minimum_employment_tenure_months: 12,
    minimum_residual_income_usd: 1500
}

# The rule set is the policy in declarative form.  This is the
# "executable spec" -- the same description a compliance officer
# reviews is what the DEDUCE step applies.  Adding a new rule means
# adding an entry here; no code changes elsewhere.
SET eligibility_rules TO {
    credit_score: "applicant.credit_score must be >= product.min_credit_score",
    dti: "computed dti_pct must be <= product.max_dti_pct",
    employment_tenure: "applicant.employment_tenure_months must be >= product.minimum_employment_tenure_months unless applicant.residence_status is 'owns_home' AND tenure >= 6",
    residual_income: "computed residual_income_usd must be >= product.minimum_residual_income_usd",
    bankruptcy: "applicant.bankruptcies_last_7_years must be 0 (hard disqualifier)",
    fraud_flags: "applicant.fraud_flags must be empty list (hard disqualifier)",
    loan_amount: "applicant.requested_loan_amount_usd must be <= product.max_loan_amount_usd",
    loan_term: "applicant.requested_term_months must be <= product.max_term_months"
}

# ============================================================
# Step 1 -- Deterministic affordability math
# ============================================================
# Computing a monthly payment from APR + term + principal is pure
# arithmetic and must be exact: a probabilistic LLM is the wrong tool.
# We do this in Python so the numbers are reproducible to the cent and
# AIEX's budget report shows $0 LLM cost for this step.

EXECUTE_CODE python:
    # Monthly payment via the standard amortisation formula.
    # P = L * (c * (1+c)^n) / ((1+c)^n - 1)
    # where c = monthly rate, n = number of payments, L = principal.
    principal = applicant["requested_loan_amount_usd"]
    n = applicant["requested_term_months"]
    monthly_rate = product["base_apr_pct"] / 100 / 12
    if monthly_rate == 0:
        monthly_payment = principal / n
    else:
        factor = (1 + monthly_rate) ** n
        monthly_payment = principal * (monthly_rate * factor) / (factor - 1)

    # Standard underwriting metrics derived from the payment.
    monthly_income = applicant["annual_income_usd"] / 12
    total_monthly_debt = applicant["monthly_debt_obligations_usd"] + monthly_payment
    dti_pct = (total_monthly_debt / monthly_income) * 100
    payment_to_income_pct = (monthly_payment / monthly_income) * 100
    residual_income = monthly_income - total_monthly_debt

    # Bundle into a single dict so the downstream DEDUCE step has a
    # single named input rather than a fan-out of loose variables.
    affordability_metrics = {
        "monthly_payment_usd": round(monthly_payment, 2),
        "monthly_income_usd": round(monthly_income, 2),
        "dti_pct": round(dti_pct, 2),
        "payment_to_income_pct": round(payment_to_income_pct, 2),
        "residual_income_usd": round(residual_income, 2),
        "principal_usd": principal,
        "term_months": n,
        "apr_pct": product["base_apr_pct"]
    }
END_EXECUTE

# ============================================================
# Step 2 -- Hard eligibility (DEDUCE)
# ============================================================
# DEDUCE is the right reasoning op here because we are applying named
# rules to inputs and asking for pass/fail per rule.  The output schema
# is fully constrained so the LLM cannot drift into prose; the contract
# enforces that every required check appears in the response, and that
# nothing outside the listed premises sneaks in.
#
# AIEX routes DEDUCE to Sonnet by default -- enough capability to apply
# rules carefully, far cheaper than Opus.

DEDUCE hard_eligibility FROM [eligibility_rules, product, affordability_metrics] WITH:
    APPLY_TO: applicant
    DEPTH: STANDARD
    RETRIEVAL_BUDGET: NONE
    MUST_INCLUDE: [
        credit_score_check,
        dti_check,
        employment_tenure_check,
        residual_income_check,
        bankruptcy_disqualifier_check,
        fraud_flag_disqualifier_check,
        loan_amount_within_product_limit_check,
        term_within_product_limit_check
    ]
    CANNOT_INCLUDE: [
        speculation_about_undisclosed_factors,
        rules_not_present_in_product,
        recommendations_about_apr_changes
    ]
    OUTPUT_FORMAT: {
        credit_score_check: TEXT IN ["pass", "fail"],
        dti_check: TEXT IN ["pass", "fail"],
        employment_tenure_check: TEXT IN ["pass", "fail"],
        residual_income_check: TEXT IN ["pass", "fail"],
        bankruptcy_disqualifier_check: TEXT IN ["pass", "fail"],
        fraud_flag_disqualifier_check: TEXT IN ["pass", "fail"],
        loan_amount_within_product_limit_check: TEXT IN ["pass", "fail"],
        term_within_product_limit_check: TEXT IN ["pass", "fail"],
        hard_outcome: TEXT IN ["all_pass", "marginal", "hard_fail"],
        failed_checks: LIST OF TEXT,
        notes: TEXT
    }
END

# ============================================================
# Step 3 -- Soft factors (WEIGH)
# ============================================================
# Borderline cases need judgment that the hard rules cannot capture:
# is the applicant's industry stable?  Is their credit history
# improving or deteriorating?  Have they been a customer for long
# enough that their behavioural data outweighs a so-so credit score?
#
# WEIGH is the right op because we are evaluating competing soft
# signals against each other and producing a directional indicator.
# AIEX routes WEIGH to Opus -- this is genuinely the kind of judgment
# that benefits from the most capable model.

WEIGH soft_factors ON applicant WITH:
    DEPTH: STANDARD
    RETRIEVAL_BUDGET: NONE
    SOURCES: [
        industry_stability,
        employment_tenure,
        residence_status,
        relationship_tenure_with_lender,
        recent_credit_inquiry_velocity
    ]
    DIMENSIONS: [
        forward_payment_capacity,
        relationship_value,
        risk_trajectory
    ]
    MUST_INCLUDE: [
        industry_assessment,
        tenure_assessment,
        relationship_assessment,
        inquiry_velocity_assessment,
        soft_factor_direction
    ]
    OUTPUT_FORMAT: {
        industry_assessment: TEXT IN ["stable", "neutral", "volatile"],
        tenure_assessment: TEXT IN ["strong", "adequate", "weak"],
        relationship_assessment: TEXT IN ["established", "new", "none"],
        inquiry_velocity_assessment: TEXT IN ["healthy", "elevated", "concerning"],
        soft_factor_direction: TEXT IN ["positive", "neutral", "negative"],
        rationale: TEXT
    }
END

# ============================================================
# Step 4 -- Final decision (SYNTHESIZE)
# ============================================================
# Combine the hard outcome with the soft direction into a single
# defensible decision.  SYNTHESIZE is the right op when integrating
# multiple structured inputs into a unified output.  AIEX routes
# SYNTHESIZE to Opus.
#
# The OUTPUT_FORMAT here is what becomes the audit record.  Every
# field is required and constrained -- there is no room for the LLM
# to invent decision categories that don't exist in policy.

SYNTHESIZE [hard_eligibility, soft_factors] INTO final_decision WITH:
    DEPTH: STANDARD
    RETRIEVAL_BUDGET: NONE
    MUST_INCLUDE: [
        decision,
        primary_rationale,
        contributing_hard_factors,
        contributing_soft_factors,
        conditions_if_any,
        confidence
    ]
    CANNOT_INCLUDE: [
        speculation_about_applicant_motivation,
        decisions_inconsistent_with_hard_outcome
    ]
    OUTPUT_FORMAT: {
        decision: TEXT IN ["APPROVE", "APPROVE_WITH_CONDITIONS", "REFER_TO_UNDERWRITER", "DECLINE"],
        primary_rationale: TEXT,
        contributing_hard_factors: LIST OF TEXT,
        contributing_soft_factors: LIST OF TEXT,
        conditions_if_any: LIST OF TEXT,
        confidence: TEXT IN ["high", "medium", "low"]
    }
END

# ============================================================
# Step 5 -- Format the audit record
# ============================================================
# Take the structured decision and produce the persisted audit log
# entry plus the customer-facing letter excerpt.  Deterministic
# string formatting -- Python is the right tool, $0 LLM cost.

EXECUTE_CODE python:
    import datetime

    # Audit log entry: machine-readable, complete, regulator-friendly.
    audit_log_entry = {
        "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
        "applicant_name": applicant["name"],
        "product": product["name"],
        "requested_amount_usd": applicant["requested_loan_amount_usd"],
        "requested_term_months": applicant["requested_term_months"],
        "computed_metrics": affordability_metrics,
        "hard_eligibility": hard_eligibility,
        "soft_factors": soft_factors,
        "final_decision": final_decision,
        "version": "loan_eligibility v1 / ailang 0.8.2"
    }

    # Customer letter: short, plain-language, derived from the structured
    # decision so wording is consistent across applicants.
    decision = final_decision["decision"]
    rationale = final_decision["primary_rationale"]
    if decision == "APPROVE":
        letter_excerpt = (
            f"Dear {applicant['name']}, we are pleased to approve your "
            f"loan request of ${applicant['requested_loan_amount_usd']:,} "
            f"over {applicant['requested_term_months']} months. {rationale}"
        )
    elif decision == "APPROVE_WITH_CONDITIONS":
        conditions = "; ".join(final_decision.get("conditions_if_any", []))
        letter_excerpt = (
            f"Dear {applicant['name']}, your loan request is conditionally "
            f"approved. Conditions: {conditions}. {rationale}"
        )
    elif decision == "REFER_TO_UNDERWRITER":
        letter_excerpt = (
            f"Dear {applicant['name']}, your application has been forwarded "
            f"to a senior underwriter for individual review. We will be in "
            f"touch within 3 business days."
        )
    else:  # DECLINE
        letter_excerpt = (
            f"Dear {applicant['name']}, we are unable to approve your loan "
            f"request at this time. {rationale} You are welcome to reapply "
            f"after addressing the cited factors."
        )
END_EXECUTE
