#ailang v0.8.2
# ============================================================
# Generated scenario: scenario_04_marginal_decline
# Applicant: Diego Ferreira, credit=685, income=$72,000/yr, requesting $15,000 over 36mo
# Generated by scenarios/generate_scenarios.py -- do not edit
# ============================================================
# ============================================================
# Personal Loan Eligibility -- AILang Business-Rules Engine
# ============================================================
#
# This program decides whether to approve a personal loan application.
# It demonstrates how a regulated business-rules workflow can be expressed
# as typed AILang reasoning operations interleaved with deterministic
# Python computation.
#
# Pipeline:
#   1. Deterministic affordability math        -> EXECUTE_CODE
#   2. Hard rule checks + hard outcome         -> EXECUTE_CODE
#   3. Soft factor / borderline judgment       -> WEIGH      (Sonnet-class)
#   4. Final decision, bound by decision_rules -> SYNTHESIZE (Sonnet-class)
#   5. Policy check, audit log + letter        -> EXECUTE_CODE
#
# Every threshold comparison is computed in Python and is exactly
# reproducible.  The model is used only where judgment is genuinely
# needed: weighing the soft factors, and choosing and wording the
# conditions and rationale within the decision rules below.
#
# The program is the spec.  The same text a compliance officer reads
# to understand the policy is what AIEX executes -- there is no separate
# "rules document -> translated into Java" step where intent gets lost.
#
# To run a scenario, copy this file into scenarios/<name>.ailang and
# replace the SET applicant block with the scenario's applicant data.

# ============================================================
# Inputs -- applicant + product
# ============================================================
# The applicant block is the only thing that varies between scenarios.
# Every other element of the program is fixed business policy.

SET applicant TO {
    name: "Diego Ferreira",
    age: 31,
    credit_score: 685,
    annual_income_usd: 72000,
    monthly_debt_obligations_usd: 1200,
    employment_status: "full_time",
    employment_tenure_months: 3,
    industry: "rideshare_gig",
    residence_status: "rents",
    requested_loan_amount_usd: 15000,
    requested_term_months: 36,
    bankruptcies_last_7_years: 0,
    fraud_flags: [],
    months_with_lender: 2,
    recent_credit_inquiries_6mo: 7
}

# The product carries the policy thresholds.  In a real deployment this
# would be retrieved from a product-catalogue service; here we inline it
# so the example is self-contained.
SET product TO {
    name: "Personal Loan -- Standard",
    base_apr_pct: 11.9,
    min_credit_score: 660,
    max_dti_pct: 43.0,
    max_loan_amount_usd: 50000,
    max_term_months: 84,
    minimum_employment_tenure_months: 12,
    homeowner_minimum_employment_tenure_months: 6,
    minimum_residual_income_usd: 1500
}

# The rule set is the policy in declarative form.  This is the
# "executable spec" a compliance officer reviews; Step 2 applies exactly
# these rules, one Python check per entry, under the same names.
SET eligibility_rules TO {
    credit_score: "applicant.credit_score must be >= product.min_credit_score",
    dti: "computed dti_pct must be <= product.max_dti_pct",
    employment_tenure: "applicant.employment_tenure_months must be >= product.minimum_employment_tenure_months, or >= product.homeowner_minimum_employment_tenure_months if applicant.residence_status is 'owns_home'",
    residual_income: "computed residual_income_usd must be >= product.minimum_residual_income_usd",
    bankruptcy: "applicant.bankruptcies_last_7_years must be 0 (disqualifier)",
    fraud_flags: "applicant.fraud_flags must be empty list (disqualifier)",
    loan_amount: "applicant.requested_loan_amount_usd must be <= product.max_loan_amount_usd (disqualifier: product limit)",
    loan_term: "applicant.requested_term_months must be <= product.max_term_months (disqualifier: product limit)"
}

# How the individual checks combine into one hard outcome:
#   - Any failed disqualifier (bankruptcy, fraud flags, product limits)
#     -> hard_fail.  No tolerance applies to a disqualifier.
#   - Otherwise, if exactly ONE of the four graded checks (credit score,
#     DTI, employment tenure, residual income) fails, and it misses its
#     threshold by no more than marginal_tolerance_pct of that threshold
#     -> marginal.  At 5%: DTI up to 45.15% (max 43.0%), credit score
#     down to 627 (min 660), tenure down to 11.4 months (min 12),
#     residual income down to $1,425 (min $1,500).
#   - Any other failure (two or more graded checks fail, or one misses
#     by more than the tolerance) -> hard_fail.
#   - No failures -> all_pass.
# Separately, a graded check that PASSES with headroom of no more than
# thin_margin_band_pct of its threshold is listed in thin_margin_checks.
# At 2%: credit score 660-673, DTI 42.14%-43.0%, tenure exactly 12
# months, residual income $1,500-$1,530.  A value exactly at its
# threshold passes, and is always a thin margin.
SET hard_outcome_policy TO {
    disqualifier_checks: ["bankruptcy", "fraud_flags", "loan_amount", "loan_term"],
    graded_checks: ["credit_score", "dti", "employment_tenure", "residual_income"],
    marginal_tolerance_pct: 5.0,
    thin_margin_band_pct: 2.0
}

# The decision rules the final step must follow.  Which rule applies is
# fixed by the hard outcome, the thin margins and the soft-factor
# direction; within APPROVE_WITH_CONDITIONS the model chooses and words
# the conditions.  Step 5 re-checks the decision against these rules.
SET decision_rules TO {
    R1_hard_fail: "hard_outcome is hard_fail -> DECLINE, whatever the soft factors say. No conditions.",
    R2_marginal: "hard_outcome is marginal -> APPROVE_WITH_CONDITIONS only if soft_factor_direction is positive or neutral AND every condition directly cures the failed check's shortfall (e.g. a smaller loan amount or a longer term that brings DTI within product.max_dti_pct). If no such cure exists, or soft_factor_direction is negative -> REFER_TO_UNDERWRITER.",
    R3_thin_margin: "hard_outcome is all_pass and thin_margin_checks is not empty -> APPROVE_WITH_CONDITIONS with exactly one verification condition per thin-margin check (e.g. re-verify the credit score, confirm the employment start date). If soft_factor_direction is negative -> REFER_TO_UNDERWRITER.",
    R4_clean_pass: "hard_outcome is all_pass and thin_margin_checks is empty -> APPROVE if soft_factor_direction is positive or neutral; REFER_TO_UNDERWRITER if negative. No conditions.",
    conditions: "conditions_if_any is empty unless the decision is APPROVE_WITH_CONDITIONS."
}

# ============================================================
# Step 1 -- Deterministic affordability math
# ============================================================
# Computing a monthly payment from APR + term + principal is pure
# arithmetic and must be exact: a probabilistic LLM is the wrong tool.
# We do this in Python so the numbers are reproducible to the cent and
# AIEX's budget report shows $0 LLM cost for this step.

EXECUTE_CODE python:
    # Monthly payment via the standard amortisation formula.
    # P = L * (c * (1+c)^n) / ((1+c)^n - 1)
    # where c = monthly rate, n = number of payments, L = principal.
    principal = applicant["requested_loan_amount_usd"]
    n = applicant["requested_term_months"]
    monthly_rate = product["base_apr_pct"] / 100 / 12
    if monthly_rate == 0:
        monthly_payment = principal / n
    else:
        factor = (1 + monthly_rate) ** n
        monthly_payment = principal * (monthly_rate * factor) / (factor - 1)

    # Standard underwriting metrics derived from the payment.
    monthly_income = applicant["annual_income_usd"] / 12
    total_monthly_debt = applicant["monthly_debt_obligations_usd"] + monthly_payment
    dti_pct = (total_monthly_debt / monthly_income) * 100
    payment_to_income_pct = (monthly_payment / monthly_income) * 100
    residual_income = monthly_income - total_monthly_debt

    # Bundle into a single dict so the downstream DEDUCE step has a
    # single named input rather than a fan-out of loose variables.
    affordability_metrics = {
        "monthly_payment_usd": round(monthly_payment, 2),
        "monthly_income_usd": round(monthly_income, 2),
        "dti_pct": round(dti_pct, 2),
        "payment_to_income_pct": round(payment_to_income_pct, 2),
        "residual_income_usd": round(residual_income, 2),
        "principal_usd": principal,
        "term_months": n,
        "apr_pct": product["base_apr_pct"]
    }
END_EXECUTE

# ============================================================
# Step 2 -- Hard eligibility and hard outcome (deterministic)
# ============================================================
# Every eligibility rule is a threshold comparison, so it is applied in
# Python: exact, reproducible, $0 LLM cost.  This step applies
# eligibility_rules check by check, records how far each value sits
# from its threshold, and classifies the hard outcome under
# hard_outcome_policy.  Nothing here is left to model judgment.

EXECUTE_CODE python:
    # Employment tenure threshold: 12 months, or 6 for a homeowner.
    if applicant["residence_status"] == "owns_home":
        _tenure_min = product["homeowner_minimum_employment_tenure_months"]
    else:
        _tenure_min = product["minimum_employment_tenure_months"]

    # Graded checks: (name, applicant value, threshold, direction).
    # "min" means the value must be >= threshold; "max" means <=.
    _graded = [
        ("credit_score", applicant["credit_score"], product["min_credit_score"], "min"),
        ("dti", affordability_metrics["dti_pct"], product["max_dti_pct"], "max"),
        ("employment_tenure", applicant["employment_tenure_months"], _tenure_min, "min"),
        ("residual_income", affordability_metrics["residual_income_usd"], product["minimum_residual_income_usd"], "min"),
    ]

    # Disqualifiers: pass/fail only, no margins and no tolerance.
    _disqualifiers = [
        ("bankruptcy", applicant["bankruptcies_last_7_years"] == 0),
        ("fraud_flags", len(applicant["fraud_flags"]) == 0),
        ("loan_amount", applicant["requested_loan_amount_usd"] <= product["max_loan_amount_usd"]),
        ("loan_term", applicant["requested_term_months"] <= product["max_term_months"]),
    ]

    # margin_pct = headroom on the passing side of the threshold, as a
    # percentage of the threshold.  Negative means a shortfall, e.g.
    # DTI 43.84% against a 43.0% max is a margin of -1.95%.
    _checks = {}
    for _name, _value, _threshold, _direction in _graded:
        _headroom = _value - _threshold if _direction == "min" else _threshold - _value
        _checks[_name] = {
            "result": "pass" if _headroom >= 0 else "fail",
            "value": _value,
            "threshold": _threshold,
            "rule": _direction,
            "margin_pct": round(_headroom / _threshold * 100, 2),
        }
    for _name, _passed in _disqualifiers:
        _checks[_name] = {"result": "pass" if _passed else "fail", "rule": "disqualifier"}

    _failed = [_n for _n in _checks if _checks[_n]["result"] == "fail"]
    _tolerance = hard_outcome_policy["marginal_tolerance_pct"]
    _band = hard_outcome_policy["thin_margin_band_pct"]

    # Hard outcome rule (see hard_outcome_policy):
    #   no failures                                              -> all_pass
    #   any disqualifier failed                                  -> hard_fail
    #   exactly one graded check failed, shortfall <= tolerance  -> marginal
    #   anything else                                            -> hard_fail
    if not _failed:
        hard_outcome = "all_pass"
    elif any(_n in hard_outcome_policy["disqualifier_checks"] for _n in _failed):
        hard_outcome = "hard_fail"
    elif len(_failed) == 1 and -_checks[_failed[0]]["margin_pct"] <= _tolerance:
        hard_outcome = "marginal"
    else:
        hard_outcome = "hard_fail"

    # Thin margins: graded checks that pass with headroom <= the band.
    thin_margin_checks = [
        _n for _n in hard_outcome_policy["graded_checks"]
        if _checks[_n]["result"] == "pass" and _checks[_n]["margin_pct"] <= _band
    ]

    hard_eligibility = {
        "checks": _checks,
        "failed_checks": _failed,
        "hard_outcome": hard_outcome,
        "thin_margin_checks": thin_margin_checks,
    }
END_EXECUTE

# ============================================================
# Step 3 -- Soft factors (WEIGH)
# ============================================================
# Borderline cases need judgment that the hard rules cannot capture:
# is the applicant's industry stable?  Is their credit history
# improving or deteriorating?  Have they been a customer for long
# enough that their behavioural data outweighs a so-so credit score?
#
# WEIGH is the right op because we are evaluating competing soft
# signals against each other and producing a directional indicator.
# AIEX routes WEIGH to Sonnet at DEPTH: STANDARD; DEPTH: EXHAUSTIVE
# would escalate it to Opus.

WEIGH soft_factors ON applicant WITH:
    DEPTH: STANDARD
    RETRIEVAL_BUDGET: NONE
    SOURCES: [
        industry_stability,
        employment_tenure,
        residence_status,
        relationship_tenure_with_lender,
        recent_credit_inquiry_velocity
    ]
    DIMENSIONS: [
        forward_payment_capacity,
        relationship_value,
        risk_trajectory
    ]
    MUST_INCLUDE: [
        industry_assessment,
        tenure_assessment,
        relationship_assessment,
        inquiry_velocity_assessment,
        soft_factor_direction
    ]
    OUTPUT_FORMAT: {
        industry_assessment: TEXT IN ["stable", "neutral", "volatile"],
        tenure_assessment: TEXT IN ["strong", "adequate", "weak"],
        relationship_assessment: TEXT IN ["established", "new", "none"],
        inquiry_velocity_assessment: TEXT IN ["healthy", "elevated", "concerning"],
        soft_factor_direction: TEXT IN ["positive", "neutral", "negative"],
        rationale: TEXT
    }
END

# ============================================================
# Step 4 -- Final decision (SYNTHESIZE)
# ============================================================
# Combine the hard outcome with the soft direction into a single
# defensible decision, following decision_rules:
#   R1  hard_fail                    -> DECLINE
#   R2  marginal                     -> APPROVE_WITH_CONDITIONS if the
#       conditions cure the shortfall and the soft direction is not
#       negative; otherwise REFER_TO_UNDERWRITER
#   R3  all_pass, thin margins       -> APPROVE_WITH_CONDITIONS, one
#       verification condition per thin-margin check
#       (REFER_TO_UNDERWRITER if the soft direction is negative)
#   R4  all_pass, no thin margins    -> APPROVE if the soft direction
#       is positive or neutral, REFER_TO_UNDERWRITER if negative
# SYNTHESIZE is the right op when integrating multiple structured
# inputs into a unified output.  AIEX routes SYNTHESIZE to Sonnet at
# DEPTH: STANDARD.
#
# The OUTPUT_FORMAT here is what becomes the audit record.  Every
# field is required and constrained -- there is no room for the LLM
# to invent decision categories that don't exist in policy, and it
# must name the decision rule it applied.

SYNTHESIZE [hard_outcome, thin_margin_checks, hard_eligibility, soft_factors, decision_rules] INTO final_decision WITH:
    DEPTH: STANDARD
    RETRIEVAL_BUDGET: NONE
    MUST_INCLUDE: [
        decision_rule_applied,
        decision,
        primary_rationale,
        contributing_hard_factors,
        contributing_soft_factors,
        conditions_if_any,
        confidence
    ]
    CANNOT_INCLUDE: [
        speculation_about_applicant_motivation,
        decisions_inconsistent_with_decision_rules
    ]
    OUTPUT_FORMAT: {
        decision_rule_applied: TEXT IN ["R1_hard_fail", "R2_marginal", "R3_thin_margin", "R4_clean_pass"],
        decision: TEXT IN ["APPROVE", "APPROVE_WITH_CONDITIONS", "REFER_TO_UNDERWRITER", "DECLINE"],
        primary_rationale: TEXT,
        contributing_hard_factors: LIST OF TEXT,
        contributing_soft_factors: LIST OF TEXT,
        conditions_if_any: LIST OF TEXT,
        confidence: TEXT IN ["high", "medium", "low"]
    }
END

# ============================================================
# Step 5 -- Policy check, audit record and letter
# ============================================================
# First re-apply decision_rules deterministically: if the model's
# decision is not one the rules allow, the application goes to an
# underwriter instead, and the audit log records why.  Then produce
# the persisted audit log entry plus the customer-facing letter
# excerpt.  Deterministic -- Python is the right tool, $0 LLM cost.

EXECUTE_CODE python:
    import datetime

    # Decisions allowed by decision_rules R1-R4 for this application.
    _direction = soft_factors["soft_factor_direction"]
    if hard_outcome == "hard_fail":
        _allowed = ["DECLINE"]                                       # R1
    elif _direction == "negative":
        _allowed = ["REFER_TO_UNDERWRITER"]                          # R2-R4
    elif hard_outcome == "marginal":
        _allowed = ["APPROVE_WITH_CONDITIONS", "REFER_TO_UNDERWRITER"]  # R2
    elif thin_margin_checks:
        _allowed = ["APPROVE_WITH_CONDITIONS"]                       # R3
    else:
        _allowed = ["APPROVE"]                                       # R4
    policy_check = {
        "allowed_decisions": _allowed,
        "model_decision": final_decision["decision"],
        "consistent": final_decision["decision"] in _allowed,
    }
    # An out-of-policy decision is never sent to the customer.
    if policy_check["consistent"]:
        decision = final_decision["decision"]
    else:
        decision = "REFER_TO_UNDERWRITER"

    # Audit log entry: machine-readable, complete, regulator-friendly.
    audit_log_entry = {
        "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
        "applicant_name": applicant["name"],
        "product": product["name"],
        "requested_amount_usd": applicant["requested_loan_amount_usd"],
        "requested_term_months": applicant["requested_term_months"],
        "computed_metrics": affordability_metrics,
        "hard_eligibility": hard_eligibility,
        "soft_factors": soft_factors,
        "final_decision": final_decision,
        "policy_check": policy_check,
        "decision_issued": decision,
        "version": "loan_eligibility v2 / ailang 0.8.2"
    }

    # Customer letter: short, plain-language, derived from the structured
    # decision so wording is consistent across applicants.
    rationale = final_decision["primary_rationale"]
    if decision == "APPROVE":
        letter_excerpt = (
            f"Dear {applicant['name']}, we are pleased to approve your "
            f"loan request of ${applicant['requested_loan_amount_usd']:,} "
            f"over {applicant['requested_term_months']} months. {rationale}"
        )
    elif decision == "APPROVE_WITH_CONDITIONS":
        conditions = "; ".join(final_decision.get("conditions_if_any", []))
        letter_excerpt = (
            f"Dear {applicant['name']}, your loan request is conditionally "
            f"approved. Conditions: {conditions}. {rationale}"
        )
    elif decision == "REFER_TO_UNDERWRITER":
        letter_excerpt = (
            f"Dear {applicant['name']}, your application has been forwarded "
            f"to a senior underwriter for individual review. We will be in "
            f"touch within 3 business days."
        )
    else:  # DECLINE
        letter_excerpt = (
            f"Dear {applicant['name']}, we are unable to approve your loan "
            f"request at this time. {rationale} You are welcome to reapply "
            f"after addressing the cited factors."
        )
END_EXECUTE
